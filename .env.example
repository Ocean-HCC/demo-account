# demo-account 配置样例。复制为 .env 后按需修改，未设置的项使用默认值。
# 完整说明见 docs/implementation.md 8.2 配置、日志与告警。

# 数据库文件，相对路径按仓库根目录解析
DEMO_ACCOUNT_DB_PATH=data/demo_account.sqlite3
# 监听地址
DEMO_ACCOUNT_HOST=127.0.0.1
DEMO_ACCOUNT_PORT=8770
# 接口访问密钥，留空为不鉴权。设置后浏览器控制台需在 localStorage 写入 demo-account.apiKey，实时推送退化为轮询
DEMO_ACCOUNT_API_KEY=

# 行情来源：tsp（本机 tick-stock-panel 加公开接口）或 mock
DEMO_ACCOUNT_MARKET=tsp
DEMO_ACCOUNT_TSP_BASE_URL=http://127.0.0.1:3018
# TSP 设了访问密码时填写
DEMO_ACCOUNT_TSP_PASSWORD=
# HTTP 客户端是否读取系统代理；本机代理会拦截部分行情主机，默认不读
DEMO_ACCOUNT_HTTP_TRUST_ENV=false

# 盘中快照周期与有效期（秒）。TSP 在本机时周期可以调到 10 秒
DEMO_ACCOUNT_SNAPSHOT_INTERVAL=60
DEMO_ACCOUNT_SNAPSHOT_MAX_AGE=180
# 即时单等待行情上限（秒）；开盘单与收盘单停牌最多顺延的交易日数
DEMO_ACCOUNT_INSTANT_ORDER_TIMEOUT=180
DEMO_ACCOUNT_MAX_DEFER_DAYS=3
# 日终结算时间（北京时间）
DEMO_ACCOUNT_SETTLE_TIME=16:00
# 基准指数
DEMO_ACCOUNT_BENCHMARK=000300.SH

# 新建账户的默认参数
DEMO_ACCOUNT_DEFAULT_INITIAL_CASH=1000000
DEMO_ACCOUNT_MIN_INITIAL_CASH=10000
DEMO_ACCOUNT_DEFAULT_COMMISSION_RATE=0.00013
DEMO_ACCOUNT_DEFAULT_MIN_COMMISSION=5
DEMO_ACCOUNT_DEFAULT_SLIPPAGE_RATE=0.0005
DEMO_ACCOUNT_DEFAULT_BLOCK_ST=true

# Webhook 最多投递次数
DEMO_ACCOUNT_WEBHOOK_MAX_ATTEMPTS=5
# 是否运行后台调度（撮合、结算、投递）
DEMO_ACCOUNT_SCHEDULER=true
# 控制台构建产物目录，默认 frontend/dist
# DEMO_ACCOUNT_FRONTEND_DIST=
